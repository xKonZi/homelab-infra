---
# Copy this file to secrets.yml (gitignored) before running playbooks/site.yml.
# Generate a strong password with: openssl rand -base64 32
# Store a copy in your password manager (required to decrypt Restic backups!).
#
# Planned upgrade in W1/W2: encrypt secrets with SOPS + age.

restic_repository_password: "CHANGE_ME_STRONG_RANDOM_PASSPHRASE"

# Local path (on the Ansible control node) to the rclone.conf containing [gdrive].
rclone_local_config_path: "{{ playbook_dir }}/../files/rclone.conf"
