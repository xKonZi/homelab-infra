---
# Copy this file to hosts.yml (gitignored) before running playbooks.
#
# Phase 1 (one-time LAN bootstrap before Tailscale is up):
#   ansible-playbook playbooks/bootstrap.yml -e ansible_host=192.168.X.Y -K
#
# Phase 2 & day-2 maintenance (over Tailscale MagicDNS):
#   ansible-playbook playbooks/site.yml -K

all:
  children:
    prod:
      hosts:
        g580:
          ansible_host: g580
          ansible_user: konzi
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519_homelab
